# Copie para .env e ajuste. Nunca versione o .env: chave e URLs de webhook são credenciais.

# Servidor HTTP
# 127.0.0.1 = só esta máquina. Use 0.0.0.0 apenas atrás de proxy com senha ou VPN (o servidor não tem autenticação).
HOST=127.0.0.1
PORT=3000

# Fontes de dados
# Chave gratuita da NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/). Vazio = arquivos públicos de 24 h.
FIRMS_MAP_KEY=
CACHE_MINUTOS=10
REGIAO_ARQUIVO=assets/regiao.geojson
FIRMS_TIMEOUT_SEGUNDOS=90
MAX_FOCOS_RESPOSTA=30000
MONITOR_MINUTOS=10
# Identifique-se na política de uso do OpenStreetMap, por exemplo: fogoamazonia/1.0 (seu-email@exemplo.com)
OSM_USER_AGENT=

# Webhook
# Padrão das áreas sem webhook próprio (Discord, n8n, Zapier...). Trate a URL como senha.
WEBHOOK_URL=
WEBHOOK_NIVEL_MINIMO=atencao
ENVIO_INTERVALO_MIN=15

# Regra de alerta (pontos de partida, não critérios técnicos validados)
DIST_ALERTA_KM=5
VENTO_MAX_KM=30
VENTO_MIN_KMH=5
IDADE_MAX_VENTO_H=6
CONFIANCA_MINIMA=nominal
APROX_MARGEM_KM=2
AVISAR_MELHORA=todos
MELHORA_MINUTOS=60

# Mesclagem e fonte geoestacionária (INPE): off, observar ou on
DEDUP_KM=1.5
INPE_GEO=off
GEO_PODE_ALERTAR=false
DEDUP_GEO_KM=4
GEO_MIN_DETECCOES=2
GEO_JANELA_HORAS=3
CACHE_GEO_MINUTOS=5
